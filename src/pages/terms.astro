<style>/* Design System: “地层与石灰” — terms retain the site's limestone space, editorial hierarchy, and unhurried rhythm. */.legal-page{max-width:850px;padding:6rem 0 7rem}.legal-page h1{margin:.5rem 0 0;font-size:clamp(3rem,7vw,5.5rem);line-height:.9}.updated{color:var(--ochre-dark);font-style:italic}.legal-page section{padding:1.6rem 0;border-top:1px solid var(--line)}.legal-page section:first-of-type{margin-top:3rem}.legal-page h2{margin:0 0 .5rem;font-size:1.4rem}.legal-page p{max-width:68ch}.legal-page section p{margin:0}@media(max-width:640px){.legal-page{padding:4rem 0 5rem}}</style>
