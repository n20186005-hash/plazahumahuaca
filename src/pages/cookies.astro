---
// Design System: “地层与石灰” — consent controls are direct, visible and paper-like, with no modal interruption or dark-pattern language.
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Cookies | Guía Plaza Mariano Gómez" description="Preferencias de cookies de la Guía Plaza Mariano Gómez.">
  <article class="legal-page section-wrap"><p class="eyebrow" data-es="Tu elección" data-en="Your choice">Tu elección</p><h1 class="display" data-es="Configuración de cookies" data-en="Cookie settings">Configuración de cookies</h1><p class="updated" data-es="Última actualización: 23 de octubre de 2026" data-en="Last updated: 23 October 2026">Última actualización: 23 de octubre de 2026</p><p class="intro" data-es="Usamos cookies para que el sitio funcione y, sólo con tu permiso, para comprender de forma agregada cómo se usa. Puedes cambiar estas preferencias aquí en cualquier momento." data-en="We use cookies for site functionality and, only with your permission, to understand in aggregate how it is used. You can change these preferences here at any time.">Usamos cookies para que el sitio funcione y, sólo con tu permiso, para comprender de forma agregada cómo se usa. Puedes cambiar estas preferencias aquí en cualquier momento.</p><section class="cookie-row"><div><h2 data-es="Cookies necesarias" data-en="Necessary cookies">Cookies necesarias</h2><p data-es="La elección de Analytics se guarda en almacenamiento local, no en una cookie de idioma. La lectura de páginas no requiere una cuenta." data-en="The Analytics choice uses local storage, not a language cookie. Reading pages requires no account.">La elección de Analytics se guarda en almacenamiento local, no en una cookie de idioma. La lectura de páginas no requiere una cuenta.</p></div><span class="always" data-es="Siempre activas" data-en="Always active">Siempre activas</span></section><section class="cookie-row"><div><h2 data-es="Cookies analíticas" data-en="Analytics cookies">Cookies analíticas</h2><p data-es="Al activarlas, permites cargar Google Analytics para conocer patrones de uso, que pueden incluir identificadores del navegador." data-en="When enabled, you allow Google Analytics to load for usage patterns, which may include browser identifiers.">Al activarlas, permites cargar Google Analytics para conocer patrones de uso, que pueden incluir identificadores del navegador.</p></div><label class="toggle"><input id="analytics" type="checkbox" /><span aria-hidden="true"></span><b class="sr-only" data-es="Activar cookies analíticas" data-en="Enable analytics cookies">Activar cookies analíticas</b></label></section><section class="cookie-row"><div><h2 data-es="Cookies de marketing" data-en="Marketing cookies">Cookies de marketing</h2><p data-es="No utilizamos cookies de publicidad personalizada en esta guía." data-en="We do not use personalised advertising cookies in this guide.">No utilizamos cookies de publicidad personalizada en esta guía.</p></div><span class="always" data-es="No utilizadas" data-en="Not used">No utilizadas</span></section><div class="actions"><button id="save-preferences" class="save" type="button" data-es="Guardar preferencias" data-en="Save preferences">Guardar preferencias</button><button id="reject-all" class="reject" type="button" data-es="Rechazar analítica" data-en="Reject analytics">Rechazar analítica</button><p id="status" role="status" aria-live="polite"></p></div></article>
</BaseLayout>
<style>/* Design System: “地层与石灰” — each choice is a well-spaced, line-defined field-note row with clear active states. */.legal-page{max-width:850px;padding:6rem 0 7rem}.legal-page h1{margin:.5rem 0 0;font-size:clamp(3rem,7vw,5.5rem);line-height:.9}.updated{color:var(--ochre-dark);font-style:italic}.intro{max-width:64ch;margin:2.3rem 0}.cookie-row{display:flex;gap:2rem;justify-content:space-between;padding:1.5rem 0;border-top:1px solid var(--line)}.cookie-row h2{margin:0 0 .35rem;font-size:1.3rem}.cookie-row p{max-width:54ch;margin:0}.always{align-self:center;flex:0 0 auto;color:var(--ochre-dark);font-size:.78rem;font-weight:700}.toggle{position:relative;align-self:center;display:block;width:47px;height:27px}.toggle input{position:absolute;opacity:0}.toggle span{position:absolute;inset:0;border-radius:20px;background:#a99786;transition:background 160ms var(--ease-out)}.toggle span::after{position:absolute;top:4px;left:4px;width:19px;height:19px;border-radius:50%;content:"";background:#fff;transition:transform 160ms var(--ease-out)}.toggle input:checked+span{background:var(--ochre-dark)}.toggle input:checked+span::after{transform:translateX(20px)}.toggle input:focus-visible+span{outline:3px solid var(--ochre);outline-offset:3px}.actions{display:flex;align-items:center;flex-wrap:wrap;gap:.8rem;padding-top:2rem}.save,.reject{min-height:44px;padding:.7rem 1rem;font:inherit;font-weight:700;cursor:pointer}.save{color:var(--paper);border:1px solid var(--umber);background:var(--umber)}.reject{color:var(--umber);border:1px solid var(--umber);background:transparent}.save:active,.reject:active{transform:scale(.97)}#status{width:100%;margin:.2rem 0 0;color:var(--sage);font-weight:600}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}@media(max-width:640px){.legal-page{padding:4rem 0 5rem}.cookie-row{gap:1rem}.always{font-size:.71rem}}</style>
