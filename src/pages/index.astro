---
// Design System: “地层与石灰” — a single-page highland field guide arranged along an irregular valley path, balancing real photography with archival graphic texture.
import BaseLayout from "../layouts/BaseLayout.astro";
const heroGraphic = "/assets/andine-topographic-hero.png";
const routeMarker = "/assets/route-marker-stone.png";
const strataPanel = "/assets/field-guide-strata-panel.png";
const plazaPhoto = "/assets/humahuaca-plaza-commons.jpg";
const valleyPhoto = "/assets/quebrada-aerial-pexels.jpeg";
const landscapePhoto = "/assets/quebrada-landscape-commons.jpg";
---

<BaseLayout title="Plaza Sargento Mariano Gómez | Guía de Humahuaca" description="Guía pública, independiente y bilingüe para visitar la Plaza Sargento Mariano Gómez en Humahuaca, Jujuy.">
  <section class="hero texture">
    <div class="hero-graphic" style={`background-image: url('${heroGraphic}')`}></div>
    <div class="hero-photo" style={`background-image: url('${landscapePhoto}')`}></div>
    <div class="hero-content section-wrap">
      <div class="hero-note" data-es="Guía de visitante · Humahuaca, Jujuy" data-en="Visitor guide · Humahuaca, Jujuy">Guía de visitante · Humahuaca, Jujuy</div>
      <h1 class="display" data-es="La plaza desde la que Humahuaca se abre al paisaje." data-en="The plaza where Humahuaca opens onto the landscape.">La plaza desde la que Humahuaca se abre al paisaje.</h1>
      <p class="hero-lede" data-es="Plaza Sargento Mariano Gómez es un punto de encuentro del casco histórico y una pausa natural antes de seguir hacia los caminos, cerros y memorias de la Quebrada." data-en="Plaza Sargento Mariano Gómez is a meeting point in the historic centre and a natural pause before following the gorge’s roads, ridges and living memories.">Plaza Sargento Mariano Gómez es un punto de encuentro del casco histórico y una pausa natural antes de seguir hacia los caminos, cerros y memorias de la Quebrada.</p>
      <div class="hero-actions">
        <a class="primary-action" href="#visita" data-es="Prepara tu visita" data-en="Plan your visit">Prepara tu visita</a>
        <a class="secondary-action" href="#mapa" data-es="Ver ubicación" data-en="View location">Ver ubicación <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div class="hero-facts" aria-label="Datos de la plaza">
      <p><span class="fact-number">4.6</span><span data-es=" valoración en Google Maps" data-en=" Google Maps rating"> valoración en Google Maps</span></p>
      <p><span class="fact-number">−23.204</span><span data-es=" latitud aproximada" data-en=" approximate latitude"> latitud aproximada</span></p>
    </div>
  </section>

  <section class="orientation section-wrap reveal" aria-label="Orientación">
    <div class="orientation-heading">
      <p class="eyebrow" data-es="El punto de partida" data-en="Your starting point">El punto de partida</p>
      <h2 class="display" data-es="Una plaza pública en una ruta cultural viva." data-en="A public plaza on a living cultural route.">Una plaza pública en una ruta cultural viva.</h2>
    </div>
    <div class="orientation-copy">
      <p data-es="La plaza se ubica en Humahuaca, al norte de la provincia de Jujuy. La localidad forma parte de la Quebrada de Humahuaca, un corredor cultural que sigue el valle del Río Grande y conserva huellas de ocupación, intercambio y movilidad de larga duración." data-en="The plaza lies in Humahuaca, in northern Jujuy Province. The town is part of the Quebrada de Humahuaca, a cultural corridor along the Río Grande valley that preserves long histories of settlement, exchange and movement.">La plaza se ubica en Humahuaca, al norte de la provincia de Jujuy. La localidad forma parte de la Quebrada de Humahuaca, un corredor cultural que sigue el valle del Río Grande y conserva huellas de ocupación, intercambio y movilidad de larga duración.</p>
      <p data-es="UNESCO describe la Quebrada como un itinerario de comunicación y comercio con evidencias de más de 10.000 años, donde paisaje, arquitectura y prácticas comunitarias siguen vinculados. Tómate el tiempo para observar: aquí el centro urbano y el entorno de altura se leen juntos." data-en="UNESCO describes the gorge as a communication and trade route with evidence spanning more than 10,000 years, where landscape, architecture and community practices remain connected. Take time to look: here, the town centre and highland setting are read together.">UNESCO describe la Quebrada como un itinerario de comunicación y comercio con evidencias de más de 10.000 años, donde paisaje, arquitectura y prácticas comunitarias siguen vinculados. Tómate el tiempo para observar: aquí el centro urbano y el entorno de altura se leen juntos.</p>
      <a class="link-arrow" href="https://whc.unesco.org/en/list/1116/" target="_blank" rel="noreferrer" data-es="Consultar la ficha de UNESCO" data-en="Read the UNESCO listing">Consultar la ficha de UNESCO</a>
    </div>
  </section>

  <section id="visita" class="visit-section texture">
    <div class="section-wrap visit-grid">
      <div class="visit-intro reveal">
        <p class="eyebrow" data-es="Lectura práctica" data-en="Practical reading">Lectura práctica</p>
        <h2 class="display" data-es="Antes de entrar en el ritmo del pueblo." data-en="Before settling into the town’s rhythm.">Antes de entrar en el ritmo del pueblo.</h2>
        <p data-es="Esta guía reúne referencias útiles sin sustituir la información local ni los avisos de seguridad. Confirma siempre condiciones de transporte, clima, actividades y accesibilidad antes de salir." data-en="This guide gathers useful reference points without replacing local information or safety notices. Always confirm transport, weather, activities and accessibility before setting out.">Esta guía reúne referencias útiles sin sustituir la información local ni los avisos de seguridad. Confirma siempre condiciones de transporte, clima, actividades y accesibilidad antes de salir.</p>
      </div>
      <div class="visit-cards">
        <article class="info-card reveal"><span>01</span><h3 data-es="Acceso y costo" data-en="Access and cost">Acceso y costo</h3><p data-es="La plaza es un espacio público. No se indica una entrada específica; museos, excursiones, eventos u otros servicios cercanos pueden establecer sus propias condiciones." data-en="The plaza is public space. No specific entry charge is indicated; nearby museums, excursions, events and services may set their own conditions.">La plaza es un espacio público. No se indica una entrada específica; museos, excursiones, eventos u otros servicios cercanos pueden establecer sus propias condiciones.</p></article>
        <article class="info-card reveal"><span>02</span><h3 data-es="Mejor momento" data-en="Best time to visit">Mejor momento</h3><p data-es="Las mañanas y las primeras horas de la tarde suelen facilitar un recorrido pausado. El entorno es seco y de altura: prioriza sombra, agua y protección solar; lleva una capa de abrigo para cambios térmicos." data-en="Morning and early afternoon generally suit an unhurried walk. The setting is dry and high-altitude: prioritise shade, water and sun protection, and bring an extra layer for temperature changes.">Las mañanas y las primeras horas de la tarde suelen facilitar un recorrido pausado. El entorno es seco y de altura: prioriza sombra, agua y protección solar; lleva una capa de abrigo para cambios térmicos.</p></article>
        <article class="info-card reveal"><span>03</span><h3 data-es="Tiempo sugerido" data-en="Suggested time">Tiempo sugerido</h3><p data-es="Reserva una pausa para recorrer el entorno inmediato y orientar tu visita. Si planeas sumar iglesias, miradores, senderos, museos o localidades vecinas, considera una jornada más amplia y ajustable." data-en="Allow time to walk the immediate area and orient your visit. If you plan to add churches, viewpoints, trails, museums or neighbouring villages, allow a broader, flexible day.">Reserva una pausa para recorrer el entorno inmediato y orientar tu visita. Si planeas sumar iglesias, miradores, senderos, museos o localidades vecinas, considera una jornada más amplia y ajustable.</p></article>
        <article class="info-card reveal"><span>04</span><h3 data-es="Consulta local" data-en="Check locally">Consulta local</h3><p data-es="La ficha de Google Maps indica apertura continua y una valoración de 4.6/5 a partir de 5.108 opiniones. Estos datos pueden cambiar y no sustituyen un aviso oficial o local." data-en="The Google Maps listing indicates continuous opening and a 4.6/5 rating from 5,108 reviews. These details can change and do not replace an official or local notice.">La ficha de Google Maps indica apertura continua y una valoración de 4.6/5 a partir de 5.108 opiniones. Estos datos pueden cambiar y no sustituyen un aviso oficial o local.</p></article>
      </div>
    </div>
  </section>

  <section id="llegar" class="arrival-section section-wrap">
    <div class="arrival-sticky reveal"><p class="eyebrow" data-es="Llegar con calma" data-en="Arrive with care">Llegar con calma</p><h2 class="display" data-es="La ruta también forma parte de la visita." data-en="The route is part of the visit, too.">La ruta también forma parte de la visita.</h2><img src={routeMarker} alt="" loading="lazy" /></div>
    <div class="arrival-list">
      <article class="arrival-item reveal"><div class="route-index">A</div><div><h3 data-es="Desde el aeropuerto" data-en="From the airport">Desde el aeropuerto</h3><p data-es="El acceso aéreo regional se realiza a través del área de San Salvador de Jujuy. Desde allí, el tramo hasta Humahuaca se completa por carretera. Planifica con margen, especialmente si encadenas vuelos con transporte terrestre." data-en="Regional air access is through the San Salvador de Jujuy area. From there, the journey to Humahuaca continues by road. Leave a comfortable margin, especially when connecting flights and ground transport.">El acceso aéreo regional se realiza a través del área de San Salvador de Jujuy. Desde allí, el tramo hasta Humahuaca se completa por carretera. Planifica con margen, especialmente si encadenas vuelos con transporte terrestre.</p></div></article>
      <article class="arrival-item reveal"><div class="route-index">B</div><div><h3 data-es="Autobús interurbano" data-en="Intercity bus">Autobús interurbano</h3><p data-es="Los servicios de larga y media distancia conectan la Quebrada con otros puntos de Jujuy. Consulta horarios, paradas, equipaje y cambios de servicio directamente con los operadores o en un punto local de información antes de viajar." data-en="Long- and medium-distance services connect the gorge with other parts of Jujuy. Check timetables, stops, luggage policies and service changes directly with operators or a local information point before travelling.">Los servicios de larga y media distancia conectan la Quebrada con otros puntos de Jujuy. Consulta horarios, paradas, equipaje y cambios de servicio directamente con los operadores o en un punto local de información antes de viajar.</p></div></article>
      <article class="arrival-item reveal"><div class="route-index">C</div><div><h3 data-es="Taxi, remís o traslado" data-en="Taxi, remís or transfer">Taxi, remís o traslado</h3><p data-es="Para grupos, equipaje o itinerarios sin horarios fijos, pregunta por servicios autorizados de taxi, remís o traslado. Acuerda el recorrido, la tarifa y el punto de encuentro antes de comenzar el viaje." data-en="For groups, luggage or unscheduled itineraries, ask about authorised taxi, remís or transfer services. Agree on the route, fare and meeting point before the journey begins.">Para grupos, equipaje o itinerarios sin horarios fijos, pregunta por servicios autorizados de taxi, remís o traslado. Acuerda el recorrido, la tarifa y el punto de encuentro antes de comenzar el viaje.</p></div></article>
      <article class="arrival-item reveal"><div class="route-index">D</div><div><h3 data-es="Vehículo particular" data-en="Private vehicle">Vehículo particular</h3><p data-es="La RN 9 estructura el acceso al pueblo. Revisa el estado de la ruta, combustible, clima y señalización antes de emprender viajes por zonas de altura. Estaciona sólo donde esté permitido y mantén libres los accesos peatonales." data-en="National Route 9 structures access to the town. Check road conditions, fuel, weather and signage before driving in highland areas. Park only where permitted and keep pedestrian access clear.">La RN 9 estructura el acceso al pueblo. Revisa el estado de la ruta, combustible, clima y señalización antes de emprender viajes por zonas de altura. Estaciona sólo donde esté permitido y mantén libres los accesos peatonales.</p></div></article>
    </div>
  </section>

  <section id="mapa" class="map-section texture">
    <div class="section-wrap map-head reveal"><p class="eyebrow" data-es="Ubicación" data-en="Location">Ubicación</p><h2 class="display" data-es="Plaza Sargento Mariano Gómez" data-en="Plaza Sargento Mariano Gómez">Plaza Sargento Mariano Gómez</h2><p data-es="Jujuy, 4630 Humahuaca, Jujuy, Argentina · Coordenadas aproximadas: −23.203974, −65.348703." data-en="Jujuy, 4630 Humahuaca, Jujuy, Argentina · Approximate coordinates: −23.203974, −65.348703.">Jujuy, 4630 Humahuaca, Jujuy, Argentina · Coordenadas aproximadas: −23.203974, −65.348703.</p></div>
    <div class="map-frame section-wrap reveal"><iframe title="Mapa de Plaza Sargento Mariano Gómez" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6527.200975952197!2d-65.35127812276856!3d-23.203968548563243!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9404e9bbafb544bb%3A0xc757afd07706a089!2sPlaza%20Sargento%20Mariano%20G%C3%B3mez!5e1!3m2!1ses-419!2sar!4v1787793280075!5m2!1ses-419!2sar" width="600" height="450" style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
  </section>

  <section id="entorno" class="environment-section">
    <div class="environment-top section-wrap reveal"><div><p class="eyebrow" data-es="Alrededor de la plaza" data-en="Around the plaza">Alrededor de la plaza</p><h2 class="display" data-es="Servicios de proximidad y paisaje cultural." data-en="Everyday services and a cultural landscape.">Servicios de proximidad y paisaje cultural.</h2></div><p data-es="La plaza conecta el recorrido urbano con experiencias de escala mayor. Usa este listado para orientarte por tipo de servicio o lugar, no como una garantía de disponibilidad ni una recomendación comercial." data-en="The plaza connects an urban walk to experiences at a larger scale. Use this list to orient yourself by service or place type, not as a guarantee of availability or a commercial endorsement.">La plaza conecta el recorrido urbano con experiencias de escala mayor. Usa este listado para orientarte por tipo de servicio o lugar, no como una garantía de disponibilidad ni una recomendación comercial.</p></div>
    <div class="photo-strip"><figure class="large-photo"><img src={valleyPhoto} alt="Vista aérea de la Quebrada de Humahuaca" loading="lazy" /><figcaption data-es="La Quebrada de Humahuaca: un corredor cultural y geográfico de escala regional." data-en="Quebrada de Humahuaca: a cultural and geographic corridor at regional scale.">La Quebrada de Humahuaca: un corredor cultural y geográfico de escala regional.</figcaption></figure><figure><img src={plazaPhoto} alt="Personas en la plaza principal de Humahuaca" loading="lazy" /><figcaption data-es="El espacio público se recorre a paso lento y con atención a la vida local." data-en="Walk public space slowly, with attention to local life.">El espacio público se recorre a paso lento y con atención a la vida local.</figcaption></figure></div>
    <div class="section-wrap service-grid">
      <article class="service-card reveal"><span class="eyebrow">01 · <span data-es="Comer" data-en="Eat">Comer</span></span><h3 data-es="Gastronomía local" data-en="Local food">Gastronomía local</h3><p data-es="En el área urbana pueden encontrarse propuestas de cocina regional, mercados y comercios de alimentos. Consulta ingredientes, horarios y condiciones de pago directamente en el lugar." data-en="The urban area may offer regional cooking, markets and food shops. Check ingredients, hours and payment conditions directly with each place.">En el área urbana pueden encontrarse propuestas de cocina regional, mercados y comercios de alimentos. Consulta ingredientes, horarios y condiciones de pago directamente en el lugar.</p></article>
      <article class="service-card reveal"><span class="eyebrow">02 · <span data-es="Quedarse" data-en="Stay">Quedarse</span></span><h3 data-es="Alojamiento" data-en="Accommodation">Alojamiento</h3><p data-es="Busca hospedajes, posadas, hosterías o campamentos habilitados según tu ruta y necesidades. Confirma accesibilidad, calefacción, horarios de recepción y reserva antes de llegar." data-en="Look for authorised lodgings, inns, guesthouses or campsites according to your route and needs. Confirm accessibility, heating, reception hours and booking arrangements before arrival.">Busca hospedajes, posadas, hosterías o campamentos habilitados según tu ruta y necesidades. Confirma accesibilidad, calefacción, horarios de recepción y reserva antes de llegar.</p></article>
      <article class="service-card reveal"><span class="eyebrow">03 · <span data-es="Abastecerse" data-en="Supplies">Abastecerse</span></span><h3 data-es="Compras y combustible" data-en="Shopping and fuel">Compras y combustible</h3><p data-es="Para agua, alimentos, productos básicos, combustible o carga de vehículos, planifica con antelación. La disponibilidad, los métodos de pago y los horarios varían según temporada y ubicación." data-en="For water, food, basic supplies, fuel or vehicle charging, plan ahead. Availability, payment methods and hours vary by season and location.">Para agua, alimentos, productos básicos, combustible o carga de vehículos, planifica con antelación. La disponibilidad, los métodos de pago y los horarios varían según temporada y ubicación.</p></article>
      <article class="service-card reveal"><span class="eyebrow">04 · <span data-es="Cuidarse" data-en="Care">Cuidarse</span></span><h3 data-es="Baños, salud y accesibilidad" data-en="Restrooms, health and access">Baños, salud y accesibilidad</h3><p data-es="No des por garantizados baños públicos, atención sanitaria o trayectos accesibles dentro de un espacio urbano histórico. Identifica opciones disponibles al llegar y solicita orientación local cuando la necesites." data-en="Do not assume public restrooms, healthcare or step-free routes are guaranteed in a historic urban setting. Identify available options on arrival and seek local guidance when needed.">No des por garantizados baños públicos, atención sanitaria o trayectos accesibles dentro de un espacio urbano histórico. Identifica opciones disponibles al llegar y solicita orientación local cuando la necesites.</p></article>
    </div>
  </section>

  <section class="landscape-story texture">
    <div class="section-wrap story-grid"><img class="story-panel" src={strataPanel} alt="" loading="lazy" /><div class="reveal"><p class="eyebrow" data-es="Mirar más allá" data-en="Looking beyond">Mirar más allá</p><h2 class="display" data-es="La plaza es la escala humana de una geografía extensa." data-en="The plaza is the human-scale part of a vast geography.">La plaza es la escala humana de una geografía extensa.</h2><p data-es="La Quebrada reúne pueblos, tramos del Río Grande, cerros, sistemas agrícolas, arquitectura y prácticas culturales. El reconocimiento de Patrimonio Mundial se refiere a ese conjunto de paisaje vivo, no a una atracción aislada." data-en="The gorge brings together towns, stretches of the Río Grande, ridges, agricultural systems, architecture and cultural practices. Its World Heritage recognition refers to this living landscape as a whole, not to one isolated attraction.">La Quebrada reúne pueblos, tramos del Río Grande, cerros, sistemas agrícolas, arquitectura y prácticas culturales. El reconocimiento de Patrimonio Mundial se refiere a ese conjunto de paisaje vivo, no a una atracción aislada.</p><p data-es="Para extender el recorrido, considera hitos públicos y patrimoniales del entorno como el Monumento a los Héroes de la Independencia, las iglesias y museos de la localidad, las terrazas de Coctaca o las vistas del Hornocal. Verifica accesos, condiciones y normas locales para cada salida." data-en="To extend your route, consider public and heritage landmarks such as the Monument to the Heroes of Independence, the town’s churches and museums, the Coctaca terraces, or views towards Hornocal. Verify access, conditions and local guidance for each outing.">Para extender el recorrido, considera hitos públicos y patrimoniales del entorno como el Monumento a los Héroes de la Independencia, las iglesias y museos de la localidad, las terrazas de Coctaca o las vistas del Hornocal. Verifica accesos, condiciones y normas locales para cada salida.</p></div></div>
  </section>

  <section class="sources-section section-wrap">
    <div class="sources-intro reveal"><p class="eyebrow" data-es="Fuentes y fotografías" data-en="Sources and photography">Fuentes y fotografías</p><h2 class="display" data-es="Para leer, contrastar y seguir explorando." data-en="Read, check and keep exploring.">Para leer, contrastar y seguir explorando.</h2></div>
    <div class="sources-list reveal"><a href="https://whc.unesco.org/en/list/1116/" target="_blank" rel="noreferrer"><strong>UNESCO</strong><span data-es="Quebrada de Humahuaca — ficha de Patrimonio Mundial" data-en="Quebrada de Humahuaca — World Heritage listing">Quebrada de Humahuaca — ficha de Patrimonio Mundial</span></a><a href="https://culturayturismo.jujuy.gob.ar/2025/07/02/la-quebrada-de-humahuaca-celebra-22-anos-como-patrimonio-mundial-de-la-humanidad/" target="_blank" rel="noreferrer"><strong>Gobierno de Jujuy</strong><span data-es="La Quebrada de Humahuaca como paisaje cultural vivo" data-en="Quebrada de Humahuaca as a living cultural landscape">La Quebrada de Humahuaca como paisaje cultural vivo</span></a><a href="https://www.argentina.gob.ar/ciencia/conae/educacion-y-formacion-masiva/quebrada-de-humahuaca-jujuy-landsat-8-oli-13-de-octubre-de-2015" target="_blank" rel="noreferrer"><strong>Argentina.gob.ar</strong><span data-es="Contexto geográfico y ambiental de la Quebrada" data-en="Geographic and environmental context for the gorge">Contexto geográfico y ambiental de la Quebrada</span></a><a href="https://www.google.com/maps/place/Plaza+Sargento+Mariano+G%C3%B3mez/@-23.2039735,-65.3487032,17z" target="_blank" rel="noreferrer"><strong>Google Maps</strong><span data-es="Ubicación, coordenadas, categoría y horario mostrado" data-en="Location, coordinates, category and displayed hours">Ubicación, coordenadas, categoría y horario mostrado</span></a></div>
