---
// Design System: “地层与石灰” — a single-page highland field guide arranged along an irregular valley path, balancing real photography with archival graphic texture.
import BaseLayout from "../layouts/BaseLayout.astro";
const heroGraphic = "/assets/andine-topographic-hero.png";
const routeMarker = "/assets/route-marker-stone.png";
const strataPanel = "/assets/field-guide-strata-panel.png";
const plazaPhoto = "/assets/humahuaca-plaza-commons.jpg";
const valleyPhoto = "/assets/quebrada-aerial-pexels.jpeg";
const landscapePhoto = "/assets/quebrada-landscape-commons.jpg";
---

<BaseLayout title="Plaza Sargento Mariano Gómez, Humahuaca: qué ver y cómo llegar" description="Guía de la Plaza Sargento Mariano Gómez en Humahuaca, Jujuy. Qué ver y hacer, la Iglesia de Candelaria, el Cabildo, artesanías y cómo llegar.">
  <section class="hero texture">
    <div class="hero-graphic" style={`background-image: url('${heroGraphic}')`}></div>
    <div class="hero-photo" style={`background-image: url('${landscapePhoto}')`}></div>
    <div class="hero-content section-wrap">
      <div class="hero-note" data-es="Guía de visitante · Humahuaca, Jujuy" data-en="Visitor guide · Humahuaca, Jujuy">Guía de visitante · Humahuaca, Jujuy</div>
      <h1 class="display" data-es="Plaza Sargento Mariano Gómez (Humahuaca)" data-en="Plaza Sargento Mariano Gómez (Humahuaca)">Plaza Sargento Mariano Gómez (Humahuaca)</h1>
      <p class="hero-lede" data-es="Bienvenido a Plaza Sargento Mariano Gómez, conocida también como la plaza central de Humahuaca o Plaza Humahuaca. Este espacio público se sitúa en el corazón de Humahuaca, Jujuy, dentro de la Quebrada de Humahuaca, Argentina." data-en="Welcome to Plaza Sargento Mariano Gómez, also known as the central plaza of Humahuaca or Plaza Humahuaca. This public square stands at the heart of Humahuaca, Jujuy, within the Quebrada de Humahuaca of Argentina.">Bienvenido a Plaza Sargento Mariano Gómez, conocida también como la plaza central de Humahuaca o Plaza Humahuaca. Este espacio público se sitúa en el corazón de Humahuaca, Jujuy, dentro de la Quebrada de Humahuaca, Argentina.</p>
      <div class="hero-actions">
        <a class="primary-action" href="#visita" data-es="Prepara tu visita" data-en="Plan your visit">Prepara tu visita</a>
        <a class="secondary-action" href="#mapa" data-es="Ver ubicación" data-en="View location">Ver ubicación <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div class="hero-facts" aria-label="Datos de la plaza">
      <p><span class="fact-number">4.6</span><span data-es=" valoración en Google Maps" data-en=" Google Maps rating"> valoración en Google Maps</span></p>
      <p><span class="fact-number">−23.204</span><span data-es=" latitud aproximada" data-en=" approximate latitude"> latitud aproximada</span></p>
    </div>
  </section>

  <section class="orientation section-wrap reveal" aria-label="Orientación">
    <div class="orientation-heading">
      <p class="eyebrow" data-es="El punto de partida" data-en="Your starting point">El punto de partida</p>
      <h2 class="display" data-es="Sobre Plaza Sargento Mariano Gómez y su contexto geográfico." data-en="About Plaza Sargento Mariano Gómez and its geographic context.">Sobre Plaza Sargento Mariano Gómez y su contexto geográfico.</h2>
    </div>
    <div class="orientation-copy">
      <p data-es="La relación geográfica puede leerse de forma directa: Plaza Sargento Mariano Gómez -> Humahuaca -> Quebrada de Humahuaca -> Jujuy -> Argentina. La plaza se encuentra en el casco histórico de Humahuaca, al norte de la provincia de Jujuy, dentro del corredor cultural andino reconocido por UNESCO." data-en="The geographic hierarchy can be read clearly: Plaza Sargento Mariano Gómez -> Humahuaca -> Quebrada de Humahuaca -> Jujuy -> Argentina. The square sits in the historic centre of Humahuaca, in northern Jujuy Province, within the Andean cultural corridor recognised by UNESCO.">La relación geográfica puede leerse de forma directa: Plaza Sargento Mariano Gómez -> Humahuaca -> Quebrada de Humahuaca -> Jujuy -> Argentina. La plaza se encuentra en el casco histórico de Humahuaca, al norte de la provincia de Jujuy, dentro del corredor cultural andino reconocido por UNESCO.</p>
      <p data-es="UNESCO describe la Quebrada como un itinerario de comunicación y comercio con evidencias de más de 10.000 años, donde paisaje, arquitectura y prácticas comunitarias siguen vinculados. En este marco, Plaza Sargento Mariano Gómez funciona como núcleo cívico y punto de orientación para recorrer la trama urbana de Humahuaca." data-en="UNESCO describes the gorge as a communication and trade route with evidence spanning more than 10,000 years, where landscape, architecture and community practices remain connected. In that setting, Plaza Sargento Mariano Gómez serves as a civic core and orientation point for moving through Humahuaca’s urban fabric.">UNESCO describe la Quebrada como un itinerario de comunicación y comercio con evidencias de más de 10.000 años, donde paisaje, arquitectura y prácticas comunitarias siguen vinculados. En este marco, Plaza Sargento Mariano Gómez funciona como núcleo cívico y punto de orientación para recorrer la trama urbana de Humahuaca.</p>
      <a class="link-arrow" href="https://whc.unesco.org/en/list/1116/" target="_blank" rel="noreferrer" data-es="Consultar la ficha de UNESCO" data-en="Read the UNESCO listing">Consultar la ficha de UNESCO</a>
    </div>
  </section>

  <section id="visita" class="visit-section texture">
    <div class="section-wrap visit-grid">
      <div class="visit-intro reveal">
        <p class="eyebrow" data-es="Lectura práctica" data-en="Practical reading">Lectura práctica</p>
        <h2 class="display" data-es="Ubicación y cómo llegar a la plaza en Humahuaca." data-en="Location and how to get to the square in Humahuaca.">Ubicación y cómo llegar a la plaza en Humahuaca.</h2>
        <p data-es="Esta guía reúne referencias útiles para localizar Plaza Sargento Mariano Gómez, comprender su posición dentro del centro histórico y planificar un acceso razonable sin sustituir la información local ni los avisos de seguridad." data-en="This guide gathers practical references to locate Plaza Sargento Mariano Gómez, understand its position within the historic centre, and plan a sensible arrival without replacing local notices or safety information.">Esta guía reúne referencias útiles para localizar Plaza Sargento Mariano Gómez, comprender su posición dentro del centro histórico y planificar un acceso razonable sin sustituir la información local ni los avisos de seguridad.</p>
      </div>
      <div class="visit-cards">
        <article class="info-card reveal"><span>01</span><h3 data-es="Acceso y costo" data-en="Access and cost">Acceso y costo</h3><p data-es="La plaza es un espacio público. No se indica una entrada específica; museos, excursiones, eventos u otros servicios cercanos pueden establecer sus propias condiciones." data-en="The plaza is public space. No specific entry charge is indicated; nearby museums, excursions, events and services may set their own conditions.">La plaza es un espacio público. No se indica una entrada específica; museos, excursiones, eventos u otros servicios cercanos pueden establecer sus propias condiciones.</p></article>
        <article class="info-card reveal"><span>02</span><h3 data-es="Mejor momento" data-en="Best time to visit">Mejor momento</h3><p data-es="Las mañanas y las primeras horas de la tarde suelen facilitar un recorrido pausado. El entorno es seco y de altura: prioriza sombra, agua y protección solar; lleva una capa de abrigo para cambios térmicos." data-en="Morning and early afternoon generally suit an unhurried walk. The setting is dry and high-altitude: prioritise shade, water and sun protection, and bring an extra layer for temperature changes.">Las mañanas y las primeras horas de la tarde suelen facilitar un recorrido pausado. El entorno es seco y de altura: prioriza sombra, agua y protección solar; lleva una capa de abrigo para cambios térmicos.</p></article>
        <article class="info-card reveal"><span>03</span><h3 data-es="Tiempo sugerido" data-en="Suggested time">Tiempo sugerido</h3><p data-es="Reserva una pausa para recorrer el entorno inmediato y orientar tu visita. Si planeas sumar iglesias, miradores, senderos, museos o localidades vecinas, considera una jornada más amplia y ajustable." data-en="Allow time to walk the immediate area and orient your visit. If you plan to add churches, viewpoints, trails, museums or neighbouring villages, allow a broader, flexible day.">Reserva una pausa para recorrer el entorno inmediato y orientar tu visita. Si planeas sumar iglesias, miradores, senderos, museos o localidades vecinas, considera una jornada más amplia y ajustable.</p></article>
        <article class="info-card reveal"><span>04</span><h3 data-es="Consulta local" data-en="Check locally">Consulta local</h3><p data-es="La ficha de Google Maps indica apertura continua y una valoración de 4.6/5 a partir de 5.108 opiniones. Estos datos pueden cambiar y no sustituyen un aviso oficial o local." data-en="The Google Maps listing indicates continuous opening and a 4.6/5 rating from 5,108 reviews. These details can change and do not replace an official or local notice.">La ficha de Google Maps indica apertura continua y una valoración de 4.6/5 a partir de 5.108 opiniones. Estos datos pueden cambiar y no sustituyen un aviso oficial o local.</p></article>
      </div>
    </div>
  </section>

  <section id="llegar" class="arrival-section section-wrap">
    <div class="arrival-sticky reveal"><p class="eyebrow" data-es="Llegar con calma" data-en="Arrive with care">Llegar con calma</p><h2 class="display" data-es="Cómo llegar a Plaza Sargento Mariano Gómez." data-en="How to reach Plaza Sargento Mariano Gómez.">Cómo llegar a Plaza Sargento Mariano Gómez.</h2><img src={routeMarker} alt="" loading="lazy" /></div>
    <div class="arrival-list">
      <article class="arrival-item reveal"><div class="route-index">A</div><div><h3 data-es="Desde el aeropuerto" data-en="From the airport">Desde el aeropuerto</h3><p data-es="El acceso aéreo regional se realiza a través del área de San Salvador de Jujuy. Desde allí, el tramo hasta Humahuaca se completa por carretera. Planifica con margen, especialmente si encadenas vuelos con transporte terrestre." data-en="Regional air access is through the San Salvador de Jujuy area. From there, the journey to Humahuaca continues by road. Leave a comfortable margin, especially when connecting flights and ground transport.">El acceso aéreo regional se realiza a través del área de San Salvador de Jujuy. Desde allí, el tramo hasta Humahuaca se completa por carretera. Planifica con margen, especialmente si encadenas vuelos con transporte terrestre.</p></div></article>
      <article class="arrival-item reveal"><div class="route-index">B</div><div><h3 data-es="Autobús interurbano" data-en="Intercity bus">Autobús interurbano</h3><p data-es="Los servicios de larga y media distancia conectan la Quebrada con otros puntos de Jujuy. Consulta horarios, paradas, equipaje y cambios de servicio directamente con los operadores o en un punto local de información antes de viajar." data-en="Long- and medium-distance services connect the gorge with other parts of Jujuy. Check timetables, stops, luggage policies and service changes directly with operators or a local information point before travelling.">Los servicios de larga y media distancia conectan la Quebrada con otros puntos de Jujuy. Consulta horarios, paradas, equipaje y cambios de servicio directamente con los operadores o en un punto local de información antes de viajar.</p></div></article>
      <article class="arrival-item reveal"><div class="route-index">C</div><div><h3 data-es="Taxi, remís o traslado" data-en="Taxi, remís or transfer">Taxi, remís o traslado</h3><p data-es="Para grupos, equipaje o itinerarios sin horarios fijos, pregunta por servicios autorizados de taxi, remís o traslado. Acuerda el recorrido, la tarifa y el punto de encuentro antes de comenzar el viaje." data-en="For groups, luggage or unscheduled itineraries, ask about authorised taxi, remís or transfer services. Agree on the route, fare and meeting point before the journey begins.">Para grupos, equipaje o itinerarios sin horarios fijos, pregunta por servicios autorizados de taxi, remís o traslado. Acuerda el recorrido, la tarifa y el punto de encuentro antes de comenzar el viaje.</p></div></article>
      <article class="arrival-item reveal"><div class="route-index">D</div><div><h3 data-es="Vehículo particular" data-en="Private vehicle">Vehículo particular</h3><p data-es="La RN 9 estructura el acceso al pueblo. Revisa el estado de la ruta, combustible, clima y señalización antes de emprender viajes por zonas de altura. Estaciona sólo donde esté permitido y mantén libres los accesos peatonales." data-en="National Route 9 structures access to the town. Check road conditions, fuel, weather and signage before driving in highland areas. Park only where permitted and keep pedestrian access clear.">La RN 9 estructura el acceso al pueblo. Revisa el estado de la ruta, combustible, clima y señalización antes de emprender viajes por zonas de altura. Estaciona sólo donde esté permitido y mantén libres los accesos peatonales.</p></div></article>
    </div>
  </section>

  <section id="mapa" class="map-section texture">
    <div class="section-wrap map-head reveal"><p class="eyebrow" data-es="Ubicación" data-en="Location">Ubicación</p><h2 class="display" data-es="Plaza Sargento Mariano Gómez" data-en="Plaza Sargento Mariano Gómez">Plaza Sargento Mariano Gómez</h2><p data-es="Jujuy, 4630 Humahuaca, Jujuy, Argentina · Coordenadas aproximadas: −23.203974, −65.348703." data-en="Jujuy, 4630 Humahuaca, Jujuy, Argentina · Approximate coordinates: −23.203974, −65.348703.">Jujuy, 4630 Humahuaca, Jujuy, Argentina · Coordenadas aproximadas: −23.203974, −65.348703.</p></div>
    <div class="map-frame section-wrap reveal"><iframe title="Mapa de Plaza Sargento Mariano Gómez" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6527.200975952197!2d-65.35127812276856!3d-23.203968548563243!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9404e9bbafb544bb%3A0xc757afd07706a089!2sPlaza%20Sargento%20Mariano%20G%C3%B3mez!5e1!3m2!1ses-419!2sar!4v1787793280075!5m2!1ses-419!2sar" width="600" height="450" style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
  </section>

  <section id="entorno" class="environment-section">
    <div class="environment-top section-wrap reveal"><div><p class="eyebrow" data-es="Alrededor de la plaza" data-en="Around the plaza">Alrededor de la plaza</p><h2 class="display" data-es="Hitos alrededor de Plaza Sargento Mariano Gómez." data-en="Landmarks around Plaza Sargento Mariano Gómez.">Hitos alrededor de Plaza Sargento Mariano Gómez.</h2></div><p data-es="Google y otros buscadores suelen confirmar la identidad de un lugar a través de sus relaciones de proximidad. En el entorno inmediato de la plaza destacan el Cabildo de Humahuaca con el campanario de San Francisco Solano, la Iglesia Catedral de Nuestra Señora de la Candelaria y el Monumento a los Héroes de la Independencia." data-en="Google and other search engines often confirm a place through its surrounding relationships. In the immediate area of the square stand the Cabildo de Humahuaca with the San Francisco Solano bell tower, the Iglesia Catedral de Nuestra Señora de la Candelaria, and the Monumento a los Héroes de la Independencia.">Google y otros buscadores suelen confirmar la identidad de un lugar a través de sus relaciones de proximidad. En el entorno inmediato de la plaza destacan el Cabildo de Humahuaca con el campanario de San Francisco Solano, la Iglesia Catedral de Nuestra Señora de la Candelaria y el Monumento a los Héroes de la Independencia.</p></div>
    <div class="photo-strip"><figure class="large-photo"><img src={valleyPhoto} alt="Vista aérea de la Quebrada de Humahuaca" loading="lazy" /><figcaption data-es="La Quebrada de Humahuaca: un corredor cultural y geográfico de escala regional." data-en="Quebrada de Humahuaca: a cultural and geographic corridor at regional scale.">La Quebrada de Humahuaca: un corredor cultural y geográfico de escala regional.</figcaption></figure><figure><img src={plazaPhoto} alt="Personas en la plaza principal de Humahuaca" loading="lazy" /><figcaption data-es="El espacio público se recorre a paso lento y con atención a la vida local." data-en="Walk public space slowly, with attention to local life.">El espacio público se recorre a paso lento y con atención a la vida local.</figcaption></figure></div>
    <div class="section-wrap service-grid">
      <article class="service-card reveal"><span class="eyebrow">01 · <span data-es="Cabildo" data-en="Cabildo">Cabildo</span></span><h3 data-es="Cabildo de Humahuaca" data-en="Cabildo de Humahuaca">Cabildo de Humahuaca</h3><p data-es="Frente a la plaza se reconoce el Cabildo de Humahuaca, edificio cívico asociado al reloj y al campanario de San Francisco Solano. Su presencia ayuda a situar con precisión el centro histórico en torno a Plaza Sargento Mariano Gómez." data-en="Facing the square stands the Cabildo de Humahuaca, a civic building associated with the clock and the San Francisco Solano bell tower. Its presence helps place the historic centre precisely around Plaza Sargento Mariano Gómez.">Frente a la plaza se reconoce el Cabildo de Humahuaca, edificio cívico asociado al reloj y al campanario de San Francisco Solano. Su presencia ayuda a situar con precisión el centro histórico en torno a Plaza Sargento Mariano Gómez.</p></article>
      <article class="service-card reveal"><span class="eyebrow">02 · <span data-es="Catedral" data-en="Cathedral">Catedral</span></span><h3 data-es="Nuestra Señora de la Candelaria" data-en="Nuestra Señora de la Candelaria">Nuestra Señora de la Candelaria</h3><p data-es="La Iglesia Catedral de Nuestra Señora de la Candelaria forma parte del mismo conjunto urbano inmediato. Mencionar plaza, cabildo e iglesia dentro de una misma secuencia refuerza la identificación de la localización en Humahuaca." data-en="The Iglesia Catedral de Nuestra Señora de la Candelaria forms part of the same immediate urban ensemble. Mentioning the square, cabildo, and church together reinforces identification of the location in Humahuaca.">La Iglesia Catedral de Nuestra Señora de la Candelaria forma parte del mismo conjunto urbano inmediato. Mencionar plaza, cabildo e iglesia dentro de una misma secuencia refuerza la identificación de la localización en Humahuaca.</p></article>
      <article class="service-card reveal"><span class="eyebrow">03 · <span data-es="Monumento" data-en="Monument">Monumento</span></span><h3 data-es="Héroes de la Independencia" data-en="Heroes of Independence">Héroes de la Independencia</h3><p data-es="Sobre la ladera cercana se alza el Monumento a los Héroes de la Independencia, uno de los hitos visuales más asociados a Humahuaca. La plaza funciona como antesala peatonal y punto de partida para leer ese paisaje histórico." data-en="On the nearby hillside rises the Monumento a los Héroes de la Independencia, one of the visual landmarks most closely tied to Humahuaca. The square works as a pedestrian forecourt and starting point for reading that historic landscape.">Sobre la ladera cercana se alza el Monumento a los Héroes de la Independencia, uno de los hitos visuales más asociados a Humahuaca. La plaza funciona como antesala peatonal y punto de partida para leer ese paisaje histórico.</p></article>
      <article class="service-card reveal"><span class="eyebrow">04 · <span data-es="Centro" data-en="Centre">Centro</span></span><h3 data-es="Casco histórico de Humahuaca" data-en="Historic centre of Humahuaca">Casco histórico de Humahuaca</h3><p data-es="La plaza también organiza la lectura del trazado urbano: calles, edificios públicos, templo y circulación de visitantes convergen aquí. Por eso Plaza Humahuaca y Plaza Sargento Mariano Gómez suelen referirse al mismo núcleo urbano central." data-en="The square also organises the reading of the urban layout: streets, public buildings, church space, and visitor circulation converge here. That is why Plaza Humahuaca and Plaza Sargento Mariano Gómez often refer to the same central urban core.">La plaza también organiza la lectura del trazado urbano: calles, edificios públicos, templo y circulación de visitantes convergen aquí. Por eso Plaza Humahuaca y Plaza Sargento Mariano Gómez suelen referirse al mismo núcleo urbano central.</p></article>
    </div>
  </section>

  <section id="alrededor" class="around-section">
    <div class="section-wrap around-top reveal">
      <div>
        <p class="eyebrow" data-es="Planifica tu recorrido" data-en="Plan your route">Planifica tu recorrido</p>
        <h2 class="display" data-es="Qué ver y qué hacer en Humahuaca" data-en="What to see and do in Humahuaca">Qué ver y qué hacer en Humahuaca</h2>
      </div>
      <p data-es="La plaza es el punto de partida natural para recorrer Humahuaca y la Quebrada de Humahuaca. Aquí se combinan hitos patrimoniales, artesanías locales y opciones para pernoctar mientras exploras la región." data-en="The square is the natural starting point for exploring Humahuaca and the Quebrada de Humahuaca. Heritage landmarks, local handicrafts and places to stay come together here as you explore the region.">La plaza es el punto de partida natural para recorrer Humahuaca y la Quebrada de Humahuaca. Aquí se combinan hitos patrimoniales, artesanías locales y opciones para pernoctar mientras exploras la región.</p>
    </div>
    <div class="section-wrap around-grid">
      <article class="around-card reveal"><span class="eyebrow">01 · <span data-es="Qué ver" data-en="What to see">Qué ver</span></span><h3 data-es="Hitos alrededor de la plaza" data-en="Landmarks around the square">Hitos alrededor de la plaza</h3><p data-es="Frente a la plaza están el Cabildo de Humahuaca y la Iglesia Catedral de Nuestra Señora de la Candelaria; en la ladera cercana se alza el Monumento a los Héroes de la Independencia. Juntos conforman el núcleo histórico que puedes recorrer a pie." data-en="Facing the square stand the Cabildo de Humahuaca and the Iglesia Catedral de Nuestra Señora de la Candelaria; on the nearby hillside rises the Monumento a los Héroes de la Independencia. Together they form the historic core you can walk.">Frente a la plaza están el Cabildo de Humahuaca y la Iglesia Catedral de Nuestra Señora de la Candelaria; en la ladera cercana se alza el Monumento a los Héroes de la Independencia. Juntos conforman el núcleo histórico que puedes recorrer a pie.</p></article>
      <article class="around-card reveal"><span class="eyebrow">02 · <span data-es="Artesanías" data-en="Handicrafts">Artesanías</span></span><h3 data-es="Artesanías y feria en Humahuaca" data-en="Handicrafts and market in Humahuaca">Artesanías y feria en Humahuaca</h3><p data-es="En torno a la plaza suelen instalarse ferias y puestos de artesanías jujeñas: tejidos de lana de llama y vicuña, cerámica, cestería y trabajo en piedra. Es una forma cercana de conocer la cultura local; los precios y horarios varían según el día y la temporada." data-en="Around the square, fairs and stalls of Jujuy handicrafts often appear: llama and vicuña wool textiles, ceramics, basketry and stonework. It is a close way to experience local culture; prices and hours vary by day and season.">En torno a la plaza suelen instalarse ferias y puestos de artesanías jujeñas: tejidos de lana de llama y vicuña, cerámica, cestería y trabajo en piedra. Es una forma cercana de conocer la cultura local; los precios y horarios varían según el día y la temporada.</p></article>
      <article class="around-card reveal"><span class="eyebrow">03 · <span data-es="Pernoctar" data-en="Stay">Pernoctar</span></span><h3 data-es="Camping y alojamiento en Humahuaca" data-en="Camping and lodging in Humahuaca">Camping y alojamiento en Humahuaca</h3><p data-es="Humahuaca y sus alrededores ofrecen opciones de camping, hosterías y hoteles. La plaza funciona como base práctica para salidas a la Quebrada. Verifica disponibilidad, temporada y servicios directamente con los operadores o la Municipalidad antes de reservar." data-en="Humahuaca and its surroundings offer camping, guesthouses and hotels. The square works as a practical base for Quebrada outings. Check availability, season and services directly with operators or the Municipality before booking.">Humahuaca y sus alrededores ofrecen opciones de camping, hosterías y hoteles. La plaza funciona como base práctica para salidas a la Quebrada. Verifica disponibilidad, temporada y servicios directamente con los operadores o la Municipalidad antes de reservar.</p></article>
    </div>
