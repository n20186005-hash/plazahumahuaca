<style>
  /* Design System: “地层与石灰” — deep umber, earth-tone rules and generous negative space close the guide with restraint. */
  .site-footer { color:#f4ecdd; background:var(--umber); }
  .footer-grid { display:grid; width:min(1180px,calc(100% - 2rem)); margin:auto; grid-template-columns:.85fr 1.15fr; gap:3rem; padding:4.5rem 0 3.5rem; }
  .footer-mark{display:block;width:3rem;height:3rem;margin:0 0 1rem;border:1px solid rgba(223,162,118,.65);background:#f4ecdd}.footer-label { color:#dfa276; }
  .site-footer h2 { max-width:17ch; margin:.5rem 0 0; font-size:clamp(2rem,4vw,3.6rem); line-height:.98; }
  .footer-copy { max-width:59ch; color:#e8dac6; font-size:.96rem; }
  .footer-copy p { margin:0 0 1rem; }
  .footer-bottom { display:flex; width:min(1180px,calc(100% - 2rem)); margin:auto; padding:1.15rem 0 1.4rem; align-items:center; justify-content:space-between; gap:1rem; border-top:1px solid rgba(244,236,221,.19); color:#cbbba7; font-size:.82rem; }
  .footer-bottom p { margin:0; }.footer-bottom nav{display:flex;gap:1rem}.footer-bottom a{color:#f4ecdd;text-decoration:none}.footer-bottom a:hover{text-decoration:underline;text-decoration-color:#dfa276;text-underline-offset:4px}
  @media(max-width:720px){.footer-grid{grid-template-columns:1fr;gap:1.5rem;padding:3.4rem 0 2.6rem}.footer-bottom{align-items:flex-start;flex-direction:column}.site-footer h2{max-width:18ch}}
</style>
