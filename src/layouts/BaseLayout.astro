---
// Design System: “地层与石灰” — the shared shell treats metadata and interaction as an extension of an independent, archival field guide.
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props { title: string; description: string; noIndex?: boolean; }
const { title, description, noIndex = false } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "https://plazahumahuaca.com";
let canonicalPath = Astro.url.pathname;
if (canonicalPath !== "/" && !canonicalPath.endsWith("/")) canonicalPath += "/";
const canonical = new URL(canonicalPath, `${siteUrl}/`).toString();
const pageUrl = canonical;

---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {!noIndex && <>
      <link rel="alternate" hreflang="es-AR" href={canonical} />
      <link rel="alternate" hreflang="x-default" href={canonical} />
    </>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon-180.png" sizes="180x180" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,650;9..144,700&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="plazahumahuaca.com" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <script is:inline src="/analytics.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#contenido" data-es="Saltar al contenido" data-en="Skip to content">Saltar al contenido</a>
    <div class="route-trail" aria-hidden="true"><svg viewBox="0 0 34 1000" preserveAspectRatio="none"><path d="M18 0 C4 85,29 136,16 210 S30 317,17 390 S2 512,19 591 S29 705,14 792 S26 902,17 1000"/><circle cx="16" cy="210" r="4"/><circle cx="17" cy="390" r="4"/><circle cx="19" cy="591" r="4"/><circle cx="14" cy="792" r="4"/></svg></div>
    <div class="page-shell">
      <SiteHeader />
      <main id="contenido"><slot /></main>
      <SiteFooter />
    </div>
    <script is:inline src="/site-controls.js"></script>
  </body>
</html>
